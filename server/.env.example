# Database configuration
DATABASE_URL=postgresql+psycopg://exposure:exposure@127.0.0.1:5432/exposure

# Session expiration (hours)
SESSION_EXPIRE_HOURS=24

# CORS allowed origins (comma-separated). Default acopera dev frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cookie de sesiune. In productie, peste HTTPS, seteaza:
#   COOKIE_SECURE=true
#   COOKIE_SAMESITE=strict
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Google OAuth — Web app (folosit pentru login pe platforma)
# IMPORTANT: foloseste `localhost` (nu `127.0.0.1`) ca sa pastram cookie-urile
# de sesiune pe acelasi domeniu cu frontend-ul (Vite ruleaza pe localhost:5173).
# Browserele trateaza `localhost` si `127.0.0.1` ca domenii diferite.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_SECRET_WEB=
GOOGLE_REDIRECT_URI_WEB=http://localhost:8000/api/v1/auth/google/callback

# Google OAuth — Desktop app (folosit pentru a verifica id_token primit de la agent)
GOOGLE_CLIENT_ID_DESKTOP=

# Frontend URL — backend face redirect aici dupa callback OAuth
FRONTEND_BASE_URL=http://localhost:5173
