"""Configuratie OAuth pentru agent — copiaza la `google_config.py` si completeaza.

Pentru build-ul production .exe, `build.ps1` ar trebui sa genereze acest fisier
inainte de PyInstaller (sau sa-l includa explicit in package)."""

# OAuth Client ID de tip "Desktop app" din Google Cloud Console.
GOOGLE_CLIENT_ID = ""

# Client Secret pentru acelasi Desktop OAuth Client. NU este real-secret (e
# bundled in executabil), dar Google's InstalledAppFlow il cere prezent.
# Il copiezi din Google Cloud Console -> Credentials -> Desktop OAuth Client.
GOOGLE_CLIENT_SECRET = ""
